{
  "name": "dunes-insolites",
  "version": "0.1.0",
  "private": true,
  "description": "Dunes Insolites — public site, backoffice and API in one workspace.",
  "workspaces": [
    "frontend",
    "admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:admin": "npm run dev --workspace admin",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "backend:compile": "node scripts/mvn.mjs -q compile",
    "backend:test": "node scripts/mvn.mjs test",
    "backend:test:unit": "node scripts/mvn.mjs test",
    "backend:test:it": "node scripts/mvn.mjs verify",
    "backend:run": "node scripts/mvn.mjs spring-boot:run",
    "backend:package": "node scripts/mvn.mjs -q package -DskipTests",
    "test:frontend": "npm run test --workspace frontend",
    "test:admin": "npm run test --workspace admin",
    "test:web": "npm run test:frontend && npm run test:admin",
    "validate:prod-config": "node scripts/validate-prod-config.mjs",
    "verify:seo": "node scripts/verify-production-urls.mjs",
    "verify:seo:coexistence": "node scripts/nginx-coexistence-test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "release:check": "node scripts/release-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:web && npm run backend:test:unit && npm run validate:prod-config",
    "verify:full": "npm run verify && npm run backend:test:it"
  },
  "engines": {
    "node": ">=20"
  }
}
