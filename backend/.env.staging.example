# Copy to .env.staging and fill in real values. Never commit .env.staging.
#
# Staging runs on its own host/domain so a sprint's work can be verified
# against a production-shaped environment before it goes live. It must use
# ITS OWN Postgres, Keycloak realm, RabbitMQ and secrets - never production's.
# application-staging.yml refuses to boot if the vars below are missing,
# specifically so staging can never fall back to talking to production.

POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KC_HOSTNAME=staging.dunesinsolites.com

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/duneinsolite
SPRING_RABBITMQ_HOST=rabbitmq
KEYCLOAK_SERVER_URL=http://keycloak:8180
APP_FRONTEND_URL=https://staging.dunes-insolites.com
APP_CORS_EXTRA_ORIGINS=https://staging.dunes-insolites.com

# A separate Gmail app password / mailbox from production, or a sandbox SMTP
# provider (e.g. Mailtrap) - staging should never send real customer email.
SPRING_MAIL_USERNAME=your-staging-smtp-username
SPRING_MAIL_PASSWORD=your-staging-smtp-password

# A separate Keycloak client secret, issued against the staging realm above.
KEYCLOAK_CLIENT_SECRET=your-staging-keycloak-client-secret

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CAMPING_EMAIL=
SEED_CAMPING_PASSWORD=
