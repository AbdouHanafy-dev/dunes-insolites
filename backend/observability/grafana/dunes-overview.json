{
  "uid": "dunes-overview",
  "title": "Dunes Insolites — service overview",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "Readiness", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "probe_success{job=\"dunes-readiness\"}" }],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
      ] } }
    },
    {
      "type": "stat", "title": "Backend scrape (up)", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "up{job=\"dunes-backend\"}" }]
    },
    {
      "type": "timeseries", "title": "HTTP request rate by status", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "5xx ratio", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 0.001)" }]
    },
    {
      "type": "timeseries", "title": "p95 request latency (s)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))" }]
    },
    {
      "type": "timeseries", "title": "JVM heap used / max", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"})" }]
    },
    {
      "type": "timeseries", "title": "Email dead-letters (15m increase)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "increase(email_dead_letter_total{action=\"recorded\"}[15m])" }]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
