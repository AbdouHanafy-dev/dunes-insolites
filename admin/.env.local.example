# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Must point at the same Keycloak realm/client the backend uses — see
# backend/.env's KEYCLOAK_CLIENT_SECRET. Without these, every route under
# /api/auth/* returns "Auth not configured".
KEYCLOAK_ISSUER_URL=http://localhost:8180/realms/duneinsolite
KEYCLOAK_CLIENT_ID=duneinsolite-api
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
ADMIN_BASE_URL=http://localhost:3100
# Must include the /api suffix — see frontend/.env.local.example for why.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
